{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "platforms": {"type": "array", "uniqueItems": true, "items": {"enum": ["codex", "cursor", "copilot"]}},
    "hooks_enabled": {"type": "boolean"},
    "selected_rules": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "selected_skills": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "selected_agents": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  }
}
