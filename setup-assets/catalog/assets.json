{
  "plugin": {
    "id": "smartkit",
    "version": "0.1.7",
    "repository": "https://github.com/wenyue/agents.git",
    "ref": "master"
  },
  "retired_assets": [
    ".agents/lock.json",
    ".agents/skills/setup-project-agents",
    ".codex/config.dart-mcp.toml",
    ".github/hooks/project-agent-tool-check.json"
  ],
  "external_skills": [
    {
      "name": "debug-mode",
      "repository": "doraemonkeys/claude-code-debug-mode",
      "ref": "master",
      "path": "debug-mode"
    }
  ],
  "assets": [
    {"id": "00-global-rule-config", "kind": "rule", "source": "setup-assets/rules/00-global-rule-config.md", "target": ".agents/rules/00-global-rule-config.md", "metadata": {"section": "global", "read_when": "Starting any repository task", "strength": "Mandatory", "cursor": {"description": "[mandatory] Rule strength, conflict precedence, and shared config policy", "alwaysApply": true}, "github": {"applyTo": "**"}}},
    {"id": "01-global-personality", "kind": "rule", "source": "setup-assets/rules/01-global-personality.md", "target": ".agents/rules/01-global-personality.md", "metadata": {"section": "global", "read_when": "Starting any repository task", "strength": "Default", "cursor": {"description": "[default] Agent reasoning, judgment, collaboration, and temperament", "alwaysApply": true}, "github": {"applyTo": "**"}}},
    {"id": "02-global-response-format", "kind": "rule", "source": "setup-assets/rules/02-global-response-format.md", "target": ".agents/rules/02-global-response-format.md", "metadata": {"section": "global", "read_when": "Starting any repository task", "strength": "Default", "cursor": {"description": "[default] Response format and tag protocol for agent replies", "alwaysApply": true}, "github": {"applyTo": "**"}}},
    {"id": "03-global-reasoning-workflow", "kind": "rule", "source": "setup-assets/rules/03-global-reasoning-workflow.md", "target": ".agents/rules/03-global-reasoning-workflow.md", "metadata": {"section": "global", "read_when": "Starting any repository task", "strength": "Mandatory", "cursor": {"description": "[mandatory] Objective understanding, professional judgment, action, and verification", "alwaysApply": true}, "github": {"applyTo": "**"}}},
    {"id": "04-global-skill-config", "kind": "rule", "source": "setup-assets/rules/04-global-skill-config.md", "target": ".agents/rules/04-global-skill-config.md", "metadata": {"section": "global", "read_when": "Starting any repository task", "strength": "Mandatory", "cursor": {"description": "[mandatory] Skill and automation constraints", "alwaysApply": true}, "github": {"applyTo": "**"}}},
    {"id": "10-base-code", "kind": "rule", "source": "setup-assets/rules/10-base-code.md", "target": ".agents/rules/10-base-code.md", "metadata": {"section": "base", "read_when": "Working with code, reviews, or implementation design", "strength": "Default", "cursor": {"description": "[default] Cross-language code goals for ownership, clarity, state, and boundaries", "globs": "**/*.{dart,cpp,c,h,hpp,cc,py,js,jsx,ts,tsx,sh}", "alwaysApply": false}, "github": {"applyTo": "**/*.{dart,cpp,c,h,hpp,cc,py,js,jsx,ts,tsx,sh}"}}},
    {"id": "11-base-cpp", "kind": "rule", "source": "setup-assets/rules/11-base-cpp.md", "target": ".agents/rules/11-base-cpp.md", "metadata": {"section": "base", "read_when": "Working with C++ files", "strength": "Default", "cursor": {"description": "[default] C++ ownership, interfaces, failure contracts, and concurrency", "globs": "**/*.cc,**/*.h", "alwaysApply": false}, "github": {"applyTo": "**/*.cc,**/*.h"}}},
    {"id": "11-base-flutter", "kind": "rule", "source": "setup-assets/rules/11-base-flutter.md", "target": ".agents/rules/11-base-flutter.md", "metadata": {"section": "base", "read_when": "Working with Dart or Flutter code", "strength": "Default", "cursor": {"description": "[default] Dart and Flutter ownership, state, lifecycle, UI, and analysis", "globs": "**/*.dart", "alwaysApply": false}, "github": {"applyTo": "**/*.dart"}}},
    {"id": "11-base-go", "kind": "rule", "source": "setup-assets/rules/11-base-go.md", "target": ".agents/rules/11-base-go.md", "metadata": {"section": "base", "read_when": "Working with Go code", "strength": "Default", "cursor": {"description": "[default] Go package ownership, errors, context, concurrency, and logging", "globs": "**/*.go", "alwaysApply": false}, "github": {"applyTo": "**/*.go"}}},
    {"id": "12-base-arb", "kind": "rule", "source": "setup-assets/rules/12-base-arb.md", "target": ".agents/rules/12-base-arb.md", "metadata": {"section": "base", "read_when": "Working with ARB localization files", "strength": "Mandatory", "cursor": {"description": "[mandatory] ARB localization, key naming, and metadata conventions", "globs": "**/*.arb", "alwaysApply": false}, "github": {"applyTo": "**/*.arb"}}},
    {"id": "change-set-verifier", "kind": "agent", "source": "setup-assets/agents/change-set-verifier.md", "target": ".agents/agents/change-set-verifier.md", "metadata": {"description": "Normalizes and verifies a coherent completed change set, then returns semantic diagnostics to the parent agent.", "codex": {"sandbox_mode": "workspace-write"}, "cursor": {"readonly": false}}},
    {"id": "refactor-code", "kind": "skill", "source": "setup-assets/skills/refactor-code", "target": ".agents/skills/refactor-code"},
    {"id": "rename", "kind": "skill", "source": "setup-assets/skills/rename", "target": ".agents/skills/rename"},
    {"id": "report-session-usage", "kind": "skill", "source": "setup-assets/skills/report-session-usage", "target": ".agents/skills/report-session-usage"},
    {"id": "worktree-integrate", "kind": "skill", "source": "setup-assets/skills/worktree-integrate", "target": ".agents/skills/worktree-integrate"},
    {"id": "write-comment", "kind": "skill", "source": "setup-assets/skills/write-comment", "target": ".agents/skills/write-comment"},
    {"id": "write-rule", "kind": "skill", "source": "setup-assets/skills/write-rule", "target": ".agents/skills/write-rule"},
    {"id": "write-skill", "kind": "skill", "source": "setup-assets/skills/write-skill", "target": ".agents/skills/write-skill"},
    {"id": "setup-project-agents", "kind": "skill", "source": "skills/setup-project-agents", "control_plane": true},
    {"id": "blueprint-project-tools", "kind": "blueprint", "source": "setup-assets/blueprints/rules/20-project-tools.md", "target": ".agents/rules/20-project-tools.md", "mode": "generate", "metadata": {"section": "project", "read_when": "Project tooling, MCP, runtime, or verification", "strength": "Mandatory", "cursor": {"alwaysApply": true}, "github": {"applyTo": "**"}}},
    {"id": "blueprint-project-rules", "kind": "blueprint", "source": "setup-assets/blueprints/rules/21-project-rules.md", "target": ".agents/rules/21-project-rules.md", "mode": "generate", "metadata": {"section": "project", "read_when": "Project APIs, generated files, lint, or domain conventions", "strength": "Default", "cursor": {"alwaysApply": true}, "github": {"applyTo": "**"}}},
    {"id": "blueprint-project-structure", "kind": "blueprint", "source": "setup-assets/blueprints/rules/22-project-structure.md", "target": ".agents/rules/22-project-structure.md", "mode": "generate", "metadata": {"section": "project", "read_when": "Making structure, module, or dependency-boundary decisions", "strength": "Advisory", "cursor": {"alwaysApply": true}, "github": {"applyTo": "**"}}},
    {"id": "blueprint-change-set-verification", "kind": "blueprint", "source": "setup-assets/blueprints/skills/change-set-verification/SKILL.md", "target": ".agents/skills/change-set-verification/SKILL.md", "mode": "generate"},
    {"id": "blueprint-worktree-environment-setup", "kind": "blueprint", "source": "setup-assets/blueprints/skills/worktree-environment-setup/SKILL.md", "target": ".agents/skills/worktree-environment-setup/SKILL.md", "mode": "generate"},
    {"id": "entry-agents", "kind": "template", "source": "setup-assets/templates/entry-files/AGENTS.md", "target": "AGENTS.md", "mode": "render"},
    {"id": "config-agents", "kind": "template", "source": "setup-assets/templates/platform-config/agents.config.json", "target": ".agents/config.json", "mode": "render"},
    {"id": "config-codex", "kind": "template", "source": "setup-assets/templates/platform-config/codex.config.toml", "target": ".codex/config.toml", "platforms": ["codex"], "mode": "render"},
    {"id": "config-codex-rules", "kind": "template", "source": "setup-assets/templates/platform-config/codex.rules", "target": ".codex/rules/setup-project-agents.rules", "platforms": ["codex"], "mode": "render"},
    {"id": "config-cursor-cli", "kind": "template", "source": "setup-assets/templates/platform-config/cursor.cli.json", "target": ".cursor/cli.json", "platforms": ["cursor"], "mode": "render"},
    {"id": "config-copilot-settings", "kind": "template", "source": "setup-assets/templates/platform-config/copilot.settings.json", "target": ".github/copilot/settings.json", "platforms": ["copilot"], "mode": "render"},
    {"id": "wrapper-agent-codex", "kind": "wrapper", "source": "setup-assets/templates/wrappers/agent-wrappers/codex.toml", "target": ".codex/agents/{agent-name}.toml", "platforms": ["codex"], "mode": "render"},
    {"id": "wrapper-agent-cursor", "kind": "wrapper", "source": "setup-assets/templates/wrappers/agent-wrappers/cursor.md", "target": ".cursor/agents/{agent-name}.md", "platforms": ["cursor"], "mode": "render"},
    {"id": "wrapper-agent-copilot", "kind": "wrapper", "source": "setup-assets/templates/wrappers/agent-wrappers/github.agent.md", "target": ".github/agents/{agent-name}.agent.md", "platforms": ["copilot"], "mode": "render"},
    {"id": "wrapper-rule-cursor", "kind": "wrapper", "source": "setup-assets/templates/wrappers/rule-wrappers/cursor.mdc", "target": ".cursor/rules/{rule-name}.mdc", "platforms": ["cursor"], "mode": "render"},
    {"id": "wrapper-rule-copilot", "kind": "wrapper", "source": "setup-assets/templates/wrappers/rule-wrappers/github.instructions.md", "target": ".github/instructions/{rule-name}.instructions.md", "platforms": ["copilot"], "mode": "render"}
  ]
}
