{
  "plugin": {
    "id": "smartkit",
    "version": "1.1.0",
    "repository": "https://github.com/wenyue/agents.git",
    "ref": "master"
  },
  "retired_assets": [
    ".agents/lock.json",
    ".agents/skills/setup-project-agents",
    ".codex/config.dart-mcp.toml",
    ".github/hooks/project-agent-tool-check.json"
  ],
  "retired_fields": [
    {
      "path": ".github/copilot/settings.json",
      "key": "extraKnownMarketplaces.superpowers-marketplace"
    },
    {
      "path": ".github/copilot/settings.json",
      "key": "enabledPlugins.superpowers@superpowers-marketplace"
    }
  ],
  "assets": [
    {
      "id": "change-set-verifier",
      "kind": "agent",
      "source": "setup-assets/agents/change-set-verifier.md",
      "target": ".agents/agents/change-set-verifier.md",
      "metadata": {
        "description": "Normalizes and verifies a coherent completed change set, then returns semantic diagnostics to the parent agent.",
        "codex": {
          "sandbox_mode": "workspace-write"
        },
        "cursor": {
          "readonly": false
        }
      }
    },
    {
      "id": "setup-project-agents",
      "kind": "skill",
      "source": "skills/setup-project-agents",
      "control_plane": true
    },
    {
      "id": "blueprint-project-tools",
      "kind": "blueprint",
      "source": "setup-assets/blueprints/rules/00-project-tools.md",
      "target": ".agents/rules/00-project-tools.md",
      "mode": "generate",
      "metadata": {
        "section": "project",
        "read_when": "Project tooling, MCP, runtime, or verification",
        "strength": "Mandatory",
        "cursor": {
          "alwaysApply": true
        },
        "github": {
          "applyTo": "**"
        }
      }
    },
    {
      "id": "blueprint-project-rules",
      "kind": "blueprint",
      "source": "setup-assets/blueprints/rules/01-project-rules.md",
      "target": ".agents/rules/01-project-rules.md",
      "mode": "generate",
      "metadata": {
        "section": "project",
        "read_when": "Project APIs, generated files, lint, or domain conventions",
        "strength": "Default",
        "cursor": {
          "alwaysApply": true
        },
        "github": {
          "applyTo": "**"
        }
      }
    },
    {
      "id": "blueprint-project-structure",
      "kind": "blueprint",
      "source": "setup-assets/blueprints/rules/02-project-structure.md",
      "target": ".agents/rules/02-project-structure.md",
      "mode": "generate",
      "metadata": {
        "section": "project",
        "read_when": "Making structure, module, or dependency-boundary decisions",
        "strength": "Advisory",
        "cursor": {
          "alwaysApply": true
        },
        "github": {
          "applyTo": "**"
        }
      }
    },
    {
      "id": "blueprint-change-set-verification",
      "kind": "blueprint",
      "source": "setup-assets/blueprints/skills/change-set-verification/SKILL.md",
      "target": ".agents/skills/change-set-verification/SKILL.md",
      "mode": "generate"
    },
    {
      "id": "blueprint-worktree-environment-setup",
      "kind": "blueprint",
      "source": "setup-assets/blueprints/skills/worktree-environment-setup/SKILL.md",
      "target": ".agents/skills/worktree-environment-setup/SKILL.md",
      "mode": "generate"
    },
    {
      "id": "blueprint-matt-issue-tracker",
      "kind": "blueprint",
      "source": "skills/setup-matt-pocock-skills/issue-tracker-local.md",
      "target": "docs/agents/issue-tracker.md",
      "mode": "generate"
    },
    {
      "id": "blueprint-matt-triage-labels",
      "kind": "blueprint",
      "source": "skills/setup-matt-pocock-skills/triage-labels.md",
      "target": "docs/agents/triage-labels.md",
      "mode": "generate"
    },
    {
      "id": "blueprint-matt-domain",
      "kind": "blueprint",
      "source": "skills/setup-matt-pocock-skills/domain.md",
      "target": "docs/agents/domain.md",
      "mode": "generate"
    },
    {
      "id": "entry-agents",
      "kind": "template",
      "source": "setup-assets/templates/entry-files/AGENTS.md",
      "target": "AGENTS.md",
      "mode": "render"
    },
    {
      "id": "config-agents",
      "kind": "template",
      "source": "setup-assets/templates/platform-config/agents.config.json",
      "target": ".agents/config.json",
      "mode": "render"
    },
    {
      "id": "config-codex",
      "kind": "template",
      "source": "setup-assets/templates/platform-config/codex.config.toml",
      "target": ".codex/config.toml",
      "platforms": [
        "codex"
      ],
      "mode": "render"
    },
    {
      "id": "config-codex-rules",
      "kind": "template",
      "source": "setup-assets/templates/platform-config/codex.rules",
      "target": ".codex/rules/setup-project-agents.rules",
      "platforms": [
        "codex"
      ],
      "mode": "render"
    },
    {
      "id": "config-cursor-cli",
      "kind": "template",
      "source": "setup-assets/templates/platform-config/cursor.cli.json",
      "target": ".cursor/cli.json",
      "platforms": [
        "cursor"
      ],
      "mode": "render"
    },
    {
      "id": "wrapper-agent-codex",
      "kind": "wrapper",
      "source": "setup-assets/templates/wrappers/agent-wrappers/codex.toml",
      "target": ".codex/agents/{agent-name}.toml",
      "platforms": [
        "codex"
      ],
      "mode": "render"
    },
    {
      "id": "wrapper-agent-cursor",
      "kind": "wrapper",
      "source": "setup-assets/templates/wrappers/agent-wrappers/cursor.md",
      "target": ".cursor/agents/{agent-name}.md",
      "platforms": [
        "cursor"
      ],
      "mode": "render"
    },
    {
      "id": "wrapper-agent-copilot",
      "kind": "wrapper",
      "source": "setup-assets/templates/wrappers/agent-wrappers/github.agent.md",
      "target": ".github/agents/{agent-name}.agent.md",
      "platforms": [
        "copilot"
      ],
      "mode": "render"
    },
    {
      "id": "wrapper-rule-cursor",
      "kind": "wrapper",
      "source": "setup-assets/templates/wrappers/rule-wrappers/cursor.mdc",
      "target": ".cursor/rules/{rule-name}.mdc",
      "platforms": [
        "cursor"
      ],
      "mode": "render"
    },
    {
      "id": "wrapper-rule-copilot",
      "kind": "wrapper",
      "source": "setup-assets/templates/wrappers/rule-wrappers/github.instructions.md",
      "target": ".github/instructions/{rule-name}.instructions.md",
      "platforms": [
        "copilot"
      ],
      "mode": "render"
    }
  ],
  "external_skill_sources": []
}
