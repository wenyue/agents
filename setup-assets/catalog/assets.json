{
  "plugin": {
    "id": "smartkit",
    "version": "1.2.4",
    "repository": "https://github.com/wenyue/agents.git",
    "ref": "master"
  },
  "assets": [
    {
      "id": "control-plane",
      "kind": "skill",
      "skill": "smartkit/setup-project-agents",
      "control_plane": true
    },
    {
      "id": "blueprint-project-tools",
      "kind": "blueprint",
      "source": "setup-assets/blueprints/rules/00-project-tools.md",
      "target": ".agents/rules/00-project-tools.md",
      "metadata": {
        "section": "project",
        "read_when": "Project tooling, MCP, runtime, or verification",
        "strength": "Mandatory",
        "cursor": {
          "alwaysApply": true
        },
        "github": {
          "applyTo": "**"
        }
      }
    },
    {
      "id": "blueprint-project-contracts",
      "kind": "blueprint",
      "source": "setup-assets/blueprints/rules/01-project-contracts.md",
      "target": ".agents/rules/01-project-contracts.md",
      "metadata": {
        "section": "project",
        "read_when": "APIs, capability ownership, installation, documentation, evaluation, contract evolution, distribution, hard dependencies, or exposure",
        "strength": "Mandatory",
        "cursor": {
          "alwaysApply": true
        },
        "github": {
          "applyTo": "**"
        }
      }
    },
    {
      "id": "blueprint-project-structure",
      "kind": "blueprint",
      "source": "setup-assets/blueprints/rules/02-project-structure.md",
      "target": ".agents/rules/02-project-structure.md",
      "metadata": {
        "section": "project",
        "read_when": "Making structure, module, or dependency-boundary decisions",
        "strength": "Advisory",
        "cursor": {
          "alwaysApply": true
        },
        "github": {
          "applyTo": "**"
        }
      }
    },
    {
      "id": "blueprint-change-set-verification",
      "kind": "blueprint",
      "source": "setup-assets/blueprints/skills/change-set-verification/SKILL.md",
      "target": ".agents/skills/change-set-verification/SKILL.md"
    },
    {
      "id": "blueprint-worktree-environment-setup",
      "kind": "blueprint",
      "source": "setup-assets/blueprints/skills/worktree-environment-setup/SKILL.md",
      "target": ".agents/skills/worktree-environment-setup/SKILL.md"
    },
    {
      "id": "entry-agents",
      "kind": "template",
      "source": "setup-assets/templates/entry-files/AGENTS.md",
      "target": "AGENTS.md"
    },
    {
      "id": "config-agents",
      "kind": "template",
      "source": "setup-assets/templates/harness-config/agents.config.json",
      "target": ".agents/config.json"
    },
    {
      "id": "config-codex",
      "kind": "template",
      "source": "setup-assets/templates/harness-config/codex.config.toml",
      "target": ".codex/config.toml",
      "harnesses": [
        "codex"
      ]
    },
    {
      "id": "config-codex-rules",
      "kind": "template",
      "source": "setup-assets/templates/harness-config/codex.rules",
      "target": ".codex/rules/setup-project-agents.rules",
      "harnesses": [
        "codex"
      ]
    },
    {
      "id": "plugin-agents-codex",
      "kind": "agent",
      "source": "agents/codex",
      "target": ".codex/agents",
      "harnesses": [
        "codex"
      ]
    },
    {
      "id": "config-cursor-cli",
      "kind": "template",
      "source": "setup-assets/templates/harness-config/cursor.cli.json",
      "target": ".cursor/cli.json",
      "harnesses": [
        "cursor"
      ]
    },
    {
      "id": "wrapper-rule-cursor",
      "kind": "wrapper",
      "source": "setup-assets/templates/wrappers/rule-wrappers/cursor.mdc",
      "target": ".cursor/rules/{rule-name}.mdc",
      "harnesses": [
        "cursor"
      ]
    },
    {
      "id": "wrapper-rule-copilot",
      "kind": "wrapper",
      "source": "setup-assets/templates/wrappers/rule-wrappers/github.instructions.md",
      "target": ".github/instructions/{rule-name}.instructions.md",
      "harnesses": [
        "copilot"
      ]
    }
  ]
}
