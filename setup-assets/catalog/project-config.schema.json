{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "selected_rules": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "selected_skills": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "selected_agents": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "external_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "url", "license", "skills"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
              "url": {"type": "string", "pattern": "^(?:https://github\\.com/|git@github\\.com:)[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\\.git)?$"},
              "ref": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
              "license": {
                "type": "object",
                "additionalProperties": false,
                "required": ["spdx", "path"],
                "properties": {
                  "spdx": {"enum": ["MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "MPL-2.0", "ISC"]},
                  "path": {"type": "string", "minLength": 1}
                }
              },
              "skills": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "path"],
                  "properties": {
                    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[a-z0-9][a-z0-9-]*$"},
                    "path": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
