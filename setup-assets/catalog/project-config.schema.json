{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "include"],
        "properties": {
          "source": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "ref": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
          "include": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "mcp": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "platforms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["codex", "cursor", "copilot"]}
          },
          "command": {"type": "string", "minLength": 1},
          "args": {"$ref": "#/$defs/stringArray"},
          "cwd": {"type": "string", "minLength": 1},
          "env": {"$ref": "#/$defs/environmentNames"},
          "url": {"type": "string", "pattern": "^https?://"},
          "overrides": {
            "type": "array",
            "items": {"$ref": "#/$defs/mcpOverride"}
          }
        },
        "oneOf": [
          {"required": ["command"], "not": {"required": ["url"]}},
          {
            "required": ["url"],
            "not": {"anyOf": [
              {"required": ["command"]}, {"required": ["args"]},
              {"required": ["cwd"]}, {"required": ["env"]}
            ]}
          }
        ]
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "environmentNames": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
    },
    "mcpOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "set"],
      "properties": {
        "when": {"$ref": "#/$defs/mcpOverrideSelector"},
        "set": {"$ref": "#/$defs/mcpOverrideValues"}
      }
    },
    "mcpOverrideSelector": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["codex", "cursor", "copilot"]}
        },
        "operatingSystems": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["windows", "linux"]}
        }
      }
    },
    "mcpOverrideValues": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "args": {"$ref": "#/$defs/stringArray"},
        "cwd": {"type": "string", "minLength": 1},
        "env": {"$ref": "#/$defs/environmentNames"},
        "url": {"type": "string", "pattern": "^https?://"}
      }
    }
  }
}
