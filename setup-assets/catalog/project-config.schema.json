{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "selected_rules": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "selected_skills": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "selected_agents": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "external_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "url", "skills"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
              "url": {"type": "string", "pattern": "^(?:https://github\\.com/|git@github\\.com:)[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\\.git)?$"},
              "ref": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
              "skills": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "path"],
                  "properties": {
                    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[a-z0-9][a-z0-9-]*$"},
                    "path": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "servers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "transport"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
              "transport": {"enum": ["stdio", "http"]},
              "platforms": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"enum": ["codex", "cursor", "copilot"]}
              },
              "command": {"type": "string", "minLength": 1},
              "args": {"$ref": "#/$defs/stringArray"},
              "cwd": {"type": "string", "minLength": 1},
              "env": {"$ref": "#/$defs/environmentNames"},
              "url": {"type": "string", "pattern": "^https?://"},
              "overrides": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "codex": {"$ref": "#/$defs/mcpOverride"},
                  "cursor": {"$ref": "#/$defs/mcpOverride"},
                  "copilot": {"$ref": "#/$defs/mcpOverride"}
                }
              },
              "readiness": {"$ref": "#/$defs/mcpReadiness"}
            },
            "allOf": [
              {
                "if": {"properties": {"transport": {"const": "stdio"}}},
                "then": {"required": ["command"], "not": {"required": ["url"]}}
              },
              {
                "if": {"properties": {"transport": {"const": "http"}}},
                "then": {
                  "required": ["url"],
                  "not": {"anyOf": [
                    {"required": ["command"]}, {"required": ["args"]},
                    {"required": ["cwd"]}, {"required": ["env"]}
                  ]}
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "environmentNames": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
    },
    "mcpOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "args": {"$ref": "#/$defs/stringArray"},
        "cwd": {"type": "string", "minLength": 1},
        "env": {"$ref": "#/$defs/environmentNames"},
        "url": {"type": "string", "pattern": "^https?://"}
      }
    },
    "mcpReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks"],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "command"],
                "properties": {
                  "kind": {"const": "command-exists"},
                  "command": {"type": "string", "minLength": 1}
                }
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "runtime", "minimum"],
                "properties": {
                  "kind": {"const": "runtime-version"},
                  "runtime": {"enum": ["node"]},
                  "minimum": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
                }
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "path"],
                "properties": {
                  "kind": {"const": "workspace-path"},
                  "path": {"type": "string", "minLength": 1},
                  "executable": {"type": "boolean"}
                }
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "name"],
                "properties": {
                  "kind": {"const": "environment-variable"},
                  "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
                }
              }
            ]
          }
        }
      }
    }
  }
}
