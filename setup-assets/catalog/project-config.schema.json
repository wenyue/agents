{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "include"],
        "properties": {
          "source": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "ref": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
          "include": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {"$ref": "#/$defs/projectAgent"}
    },
    "mcp": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "platforms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["codex", "cursor", "copilot"]}
          },
          "command": {"type": "string", "minLength": 1},
          "args": {"$ref": "#/$defs/stringArray"},
          "cwd": {"type": "string", "minLength": 1},
          "env": {"$ref": "#/$defs/environmentNames"},
          "url": {"type": "string", "pattern": "^https?://"},
          "overrides": {
            "type": "array",
            "items": {"$ref": "#/$defs/mcpOverride"}
          },
          "readiness": {"$ref": "#/$defs/mcpReadiness"}
        },
        "oneOf": [
          {"required": ["command"], "not": {"required": ["url"]}},
          {
            "required": ["url"],
            "not": {"anyOf": [
              {"required": ["command"]}, {"required": ["args"]},
              {"required": ["cwd"]}, {"required": ["env"]}
            ]}
          }
        ]
      }
    }
  },
  "$defs": {
    "projectAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "description", "platforms"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "source": {
          "type": "string",
          "pattern": "^\\.agents/agents/[a-z0-9][a-z0-9-]*\\.md$"
        },
        "description": {"type": "string", "minLength": 1},
        "platforms": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "codex": {"$ref": "#/$defs/codexAgent"},
            "cursor": {"$ref": "#/$defs/cursorAgent"},
            "copilot": {"$ref": "#/$defs/copilotAgent"}
          }
        }
      }
    },
    "codexAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sandbox_mode"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "model_reasoning_effort": {"type": "string", "minLength": 1},
        "sandbox_mode": {"type": "string", "minLength": 1}
      }
    },
    "cursorAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readonly"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "readonly": {"type": "boolean"}
      }
    },
    "copilotAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disable_model_invocation"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "disable_model_invocation": {"type": "boolean"}
      }
    },
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "environmentNames": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
    },
    "mcpOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "set"],
      "properties": {
        "when": {"$ref": "#/$defs/mcpOverrideSelector"},
        "set": {"$ref": "#/$defs/mcpOverrideValues"}
      }
    },
    "mcpOverrideSelector": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["codex", "cursor", "copilot"]}
        },
        "operatingSystems": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["windows", "linux"]}
        }
      }
    },
    "mcpOverrideValues": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "args": {"$ref": "#/$defs/stringArray"},
        "cwd": {"type": "string", "minLength": 1},
        "env": {"$ref": "#/$defs/environmentNames"},
        "url": {"type": "string", "pattern": "^https?://"}
      }
    },
    "mcpReadiness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["codex", "cursor", "copilot"]}
        },
        "operatingSystems": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["windows", "linux"]}
        },
        "checks": {
          "type": "array",
          "items": {"$ref": "#/$defs/mcpReadinessCheck"}
        }
      }
    },
    "mcpReadinessCheck": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "command"],
          "properties": {
            "kind": {"const": "command-exists"},
            "command": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "runtime", "minimum"],
          "properties": {
            "kind": {"const": "runtime-version"},
            "runtime": {"const": "node"},
            "minimum": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": {"const": "workspace-path"},
            "path": {"type": "string", "minLength": 1},
            "executable": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": {"const": "environment-variable"},
            "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
          }
        }
      ]
    }
  }
}
