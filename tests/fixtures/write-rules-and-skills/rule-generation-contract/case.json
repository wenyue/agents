    {
      "id": "ambiguous-location",
      "risk": "placement",
      "input": {"owner": "project", "scope": "records", "write_location": [".agents/rules/20-record-retention.md", "rules/retention.md"]},
      "expected": {"next_action": "stop-for-location-decision"}
