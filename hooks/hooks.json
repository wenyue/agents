{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/runtime/recommended-tools/check_recommended_tools.sh\" hook --harness codex",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}\\runtime\\recommended-tools\\check_recommended_tools.ps1\" hook --harness codex",
            "timeout": 30,
            "statusMessage": "Checking daily project readiness"
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/runtime/rules/dispatch.py\" --harness codex --event session",
            "commandWindows": "python \"${PLUGIN_ROOT}\\runtime\\rules\\dispatch.py\" --harness codex --event session",
            "timeout": 30,
            "additionalContextLimit": 50000,
            "statusMessage": "Loading SmartKit plugin rules"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/runtime/rules/dispatch.py\" --harness codex --event prompt",
            "commandWindows": "python \"${PLUGIN_ROOT}\\runtime\\rules\\dispatch.py\" --harness codex --event prompt",
            "timeout": 30,
            "additionalContextLimit": 50000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/runtime/rules/dispatch.py\" --harness codex --event tool",
            "commandWindows": "python \"${PLUGIN_ROOT}\\runtime\\rules\\dispatch.py\" --harness codex --event tool",
            "timeout": 30,
            "additionalContextLimit": 50000
          }
        ]
      }
    ]
  }
}
