{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "name": "smartkit recommended-tool consent context",
        "command": "python \"${CURSOR_PLUGIN_ROOT}/runtime/recommended-tools/check_recommended_tools.py\" hook --platform cursor --delivery context"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "name": "smartkit recommended-tool consent check",
        "command": "python \"${CURSOR_PLUGIN_ROOT}/runtime/recommended-tools/check_recommended_tools.py\" hook --platform cursor"
      }
    ]
  }
}
